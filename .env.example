# c0c0n 2026 — "Closing the Tag, 0wning the Agent" demo config.
# Copy to .env. NEVER put access keys here — use AWS_PROFILE + host SSO/creds.

# --- AWS access (credential chain / SSO profile mounted read-only) ---
AWS_PROFILE=myiamadmin
AWS_REGION=us-east-1

# --- Classic agent (classic-live). Default = presenter's working Nova agent. ---
BEDROCK_AGENT_ID=SDECXM5QWK
BEDROCK_AGENT_ALIAS_ID=TSTALIASID

# --- Model. VERIFIED: use the BARE Nova id for a Classic agent (the us.* profile
#     failed at orchestration on this account). Choose model as an OUTPUT of the
#     baseline census, not an input. ---
BEDROCK_NOVA_MODEL_ID=amazon.nova-pro-v1:0

# --- Provider mode: classic-live | recorded-live | nova-lab ---
DEMO_MODE=classic-live

# --- Local safety caps (experiment engine) ---
MAX_INFLIGHT=1
MAX_TOTAL_CALLS=30
MAX_OUTPUT_TOKENS=1024
MAX_WALL_SECONDS=600
MAX_ESTIMATED_SPEND_USD=

# --- Resource naming for created AWS resources + teardown scope ---
RESOURCE_PREFIX=c0c0n-demo

# --- Ports (loopback only). APP_PORT = the UI you open; DEV_PORT = vite dev. ---
APP_PORT=8080
DEV_PORT=5173
